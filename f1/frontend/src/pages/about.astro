---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/api.js';

const sections = [
  {
    title: 'What you can explore',
    items: [
      ['Overview', 'Both champions, the title fights and the winner and pole sitter of every round.', '/'],
      ['Standings', "Final drivers' and constructors' tables with the points gap to the leader.", '/standings'],
      ['Drivers', 'A profile for each driver, with points by round and every result.', '/drivers'],
      ['Teams', 'Each team\'s drivers, podiums and results round by round.', '/constructors'],
      ['Races', 'Circuit facts, full race results and qualifying times for all 24 rounds.', '/races'],
    ],
  },
];

const stack = [
  ['Frontend', 'Astro, React and Tailwind CSS'],
  ['Backend', 'Flask REST API with SQLAlchemy over SQLite'],
  ['Data', 'Jolpica F1 API, the community successor to the Ergast API'],
  ['Hosting', 'GitHub Pages, built and deployed with GitHub Actions'],
];
---

<Layout title="About · F1 2024" heading="About this project" subtitle="A data explorer for the 2024 Formula 1 season">
  <div class="grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
      <section class="card p-5 sm:p-6">
        <h2 class="font-semibold">Overview</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          F1 2024 Season Explorer brings the complete 2024 season into one place: standings, driver and team
          profiles, and the result of every race and qualifying session. Season data is loaded from the
          Jolpica F1 API into a SQLite database and served through a Flask REST API. The published site is a
          static build with that data exported as JSON, so it needs no running server.
        </p>
      </section>

      {sections.map((section) => (
        <section class="card">
          <h2 class="border-b border-line px-5 py-3 text-sm font-semibold">{section.title}</h2>
          <ul class="divide-y divide-line">
            {section.items.map(([name, text, href]) => (
              <li>
                <a href={url(href)} class="flex items-start gap-4 px-5 py-3.5 transition-colors hover:bg-subtle">
                  <span class="w-24 shrink-0 text-sm font-medium">{name}</span>
                  <span class="text-sm text-muted">{text}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="space-y-6">
      <section class="card">
        <h2 class="border-b border-line px-5 py-3 text-sm font-semibold">Built with</h2>
        <dl class="space-y-3 p-5 text-sm">
          {stack.map(([label, value]) => (
            <div>
              <dt class="label">{label}</dt>
              <dd class="mt-0.5">{value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="card p-5">
        <h2 class="text-sm font-semibold">Data source</h2>
        <p class="mt-2 text-sm text-muted">
          Results and standings come from the Jolpica F1 API. Points in the standings include sprint races;
          per-race figures cover Grands Prix only.
        </p>
        <a href="https://github.com/jolpica/jolpica-f1" target="_blank" rel="noopener noreferrer" class="btn mt-4">
          Jolpica F1 on GitHub
        </a>
      </section>

      <p class="px-1 text-xs leading-relaxed text-faint">
        This is an unofficial fan project and is not associated with Formula 1, the FIA or any team.
        Driver photos and circuit maps are loaded from their original sources.
      </p>
    </div>
  </div>
</Layout>
