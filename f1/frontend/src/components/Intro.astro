---
/**
 * Opening intro: a pre-rendered video of the RB19 and the Mercedes W17 racing
 * wheel to wheel on a night circuit (made in Blender) that plays once per
 * browser session over whichever page the visitor lands on. As the cars pass
 * either side of the camera they throw a burst of sparks; the page is revealed
 * through them. Model credits are on the About page.
 *
 * Skipped for visitors who prefer reduced motion, after the first page of a
 * session, and whenever the video can't play (blocked autoplay, slow network).
 */
import { url } from '../utils/api.js';

const video = url('/intro/rb19_intro.mp4');
const poster = url('/intro/rb19_poster.jpg');
---

<script is:inline>
  // Decide before the page paints, so returning visitors never see a flash of it
  (function () {
    var seen = false;
    try { seen = sessionStorage.getItem('introSeen') === '1'; } catch (e) {}
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add(seen || reduced ? 'intro-off' : 'intro-on');
  })();
</script>

<div id="intro" data-video={video} data-poster={poster}>
  <!-- The video's src is only set when the intro plays, so it is never downloaded otherwise -->
  <video id="intro-video" muted playsinline preload="auto" aria-hidden="true"></video>
  <div class="intro-letterbox intro-letterbox-top" aria-hidden="true"></div>
  <div class="intro-letterbox intro-letterbox-bottom" aria-hidden="true"></div>
  <div id="intro-caption" aria-hidden="true">
    <span class="intro-tick"></span>
    <span>Las Vegas</span>
    <span class="intro-rule"></span>
    <span>Round 22 of 24</span>
    <span class="intro-rule"></span>
    <span>23 Nov 2024</span>
  </div>
  <button id="intro-skip" type="button">Skip intro</button>
</div>

<style is:global>
  html.intro-off #intro { display: none; }
  html.intro-on { overflow: hidden; }   /* no scrolling the page behind the intro */

  #intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #000;
    transition: opacity 600ms ease;
  }
  #intro.is-leaving { opacity: 0; pointer-events: none; }

  #intro-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  /* Widescreen letterbox; the bars slide away as the page is revealed */
  .intro-letterbox {
    position: absolute;
    left: 0;
    right: 0;
    height: 9vh;
    background: #000;
    will-change: transform;
  }
  .intro-letterbox-top { top: 0; }
  .intro-letterbox-bottom { bottom: 0; }

  /* Broadcast-style caption */
  #intro-caption {
    position: absolute;
    left: max(24px, 4vw);
    bottom: calc(9vh + 22px);
    display: flex;
    align-items: center;
    gap: 14px;
    font: 500 11px/1 'Geist Mono', ui-monospace, monospace;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(240 239 236 / 0.86);
    opacity: 0;
    pointer-events: none;
  }
  .intro-tick { width: 3px; height: 14px; background: #e10600; transform: skewX(-12deg); }
  .intro-rule { width: 1px; height: 10px; background: rgb(255 255 255 / 0.3); }
  @media (max-width: 560px) {
    #intro-caption { gap: 10px; font-size: 9px; letter-spacing: 0.16em; }
  }

  #intro-skip {
    position: absolute;
    right: max(20px, 3vw);
    bottom: calc(4.5vh - 17px);
    border: 0;
    border-radius: 2px;
    padding: 10px 14px;
    background: rgb(255 255 255 / 0.08);
    color: #d5d9df;
    font: 500 11px/1 'Geist', system-ui, sans-serif;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    transition: opacity 300ms ease 400ms, background-color 150ms ease;
  }
  #intro.is-ready #intro-skip { opacity: 1; }
  #intro-skip:hover { background: rgb(255 255 255 / 0.16); }
  #intro-skip:focus-visible { outline: 2px solid #e10600; outline-offset: 2px; }
</style>

<script>
  const intro = document.getElementById('intro');
  const root = document.documentElement;

  if (intro && root.classList.contains('intro-on')) {
    const video = intro.querySelector<HTMLVideoElement>('#intro-video')!;
    const caption = intro.querySelector<HTMLElement>('#intro-caption')!;
    const skip = intro.querySelector<HTMLButtonElement>('#intro-skip')!;
    const barTop = intro.querySelector<HTMLElement>('.intro-letterbox-top')!;
    const barBottom = intro.querySelector<HTMLElement>('.intro-letterbox-bottom')!;

    const FADE_AT = 1.92;   // seconds into the video: the spark burst fills the screen
    const FADE = 0.4;       // seconds for the fade through the sparks to the page
    const smooth = (t: number) => { t = Math.max(0, Math.min(1, t)); return t * t * (3 - 2 * t); };

    let finished = false;
    let fadeStart: number | null = null;

    const finish = (fade = false) => {
      if (finished) return;
      finished = true;
      try { sessionStorage.setItem('introSeen', '1'); } catch {}
      const done = () => {
        video.pause();
        video.removeAttribute('src');
        intro.remove();
        root.classList.remove('intro-on');
        root.classList.add('intro-off');
        window.dispatchEvent(new Event('intro:finished'));
      };
      if (fade) {
        intro.style.transition = '';
        intro.style.opacity = '';
        intro.classList.add('is-leaving');
        setTimeout(done, 600);
      } else {
        done();
      }
    };

    skip.addEventListener('click', () => finish(true));
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape') finish(true);
    });

    // Caption, letterbox and fade all follow the video's own clock
    const update = () => {
      const t = video.currentTime;
      caption.style.opacity = String(smooth((t - 0.15) / 0.35) * (1 - smooth((t - 0.95) / 0.35)));
      if (fadeStart === null && t >= FADE_AT) fadeStart = performance.now();
      const out = fadeStart === null ? 0 : smooth((performance.now() - fadeStart) / (FADE * 1000));
      intro.style.transition = 'none';
      intro.style.opacity = String(1 - out);
      barTop.style.transform = `translateY(${-out * 100}%)`;
      barBottom.style.transform = `translateY(${out * 100}%)`;
      if (out >= 1) finish();
      else if (!finished) requestAnimationFrame(update);
    };

    // Never hold the site hostage: if the video hasn't started within 5 s, move on
    const giveUp = setTimeout(() => finish(), 5000);
    video.addEventListener('playing', () => {
      clearTimeout(giveUp);
      intro.classList.add('is-ready');
      requestAnimationFrame(update);
    }, { once: true });
    video.addEventListener('ended', () => { if (fadeStart === null) fadeStart = performance.now(); });
    video.addEventListener('error', () => finish());

    video.poster = intro.dataset.poster!;
    video.src = intro.dataset.video!;
    video.play().catch(() => finish());   // autoplay refused: go straight to the site
  }
</script>
