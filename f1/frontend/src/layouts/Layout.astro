---
/**
 * Main layout: sidebar navigation on desktop, top bar with a slide-out menu on
 * mobile, a light/dark theme toggle, and an optional page header.
 */
import '../styles/global.css';
import { url } from '../utils/api.js';

interface Props {
  title: string;          // document title
  heading?: string;       // page heading (omit for pages that render their own)
  subtitle?: string;      // short line under the heading
  description?: string;   // meta description
}

const {
  title,
  heading,
  subtitle,
  description = 'Explore the 2024 Formula 1 season: standings, drivers, teams and every race result.',
} = Astro.props;

// Navigation items. Icons are 24x24 outline paths.
const nav = [
  { href: '/', label: 'Overview', icon: 'M3 12l9-8 9 8M5 10v10h5v-6h4v6h5V10' },
  { href: '/standings', label: 'Standings', icon: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3' },
  { href: '/drivers', label: 'Drivers', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0' },
  { href: '/constructors', label: 'Teams', icon: 'M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20a6 6 0 0 1 12 0M14 20a6 6 0 0 1 8-5.6' },
  { href: '/races', label: 'Races', icon: 'M5 21V4M5 4h11l-2 4 2 4H5' },
];
const secondaryNav = [
  { href: '/about', label: 'About', icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 11v5M12 8h.01' },
];

// Mark the current section (the overview only matches exactly)
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/+$/, '') || '/';
  return href === '/' ? current === target : current === target || current.startsWith(target + '/');
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>

    <!-- Apply the saved or system theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>

  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] btn">Skip to content</a>

    <!-- Mobile top bar -->
    <header class="sticky top-0 z-40 flex h-14 items-center justify-between border-b border-line bg-surface/90 px-4 backdrop-blur lg:hidden">
      <a href={url('/')} class="flex items-center gap-2 font-semibold">
        <span class="grid h-7 w-7 place-items-center rounded-md bg-accent text-xs font-bold text-white">F1</span>
        <span>2024 Season</span>
      </a>
      <button id="menu-open" type="button" class="btn px-2" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </header>

    <!-- Backdrop for the mobile menu -->
    <div id="menu-backdrop" class="fixed inset-0 z-40 hidden bg-black/40 lg:hidden"></div>

    <!-- Sidebar -->
    <aside
      id="sidebar"
      class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-line bg-surface transition-transform duration-200 lg:translate-x-0"
      aria-label="Main navigation"
    >
      <div class="flex h-16 items-center justify-between px-5">
        <a href={url('/')} class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-sm font-bold text-white">F1</span>
          <span class="leading-tight">
            <span class="block text-sm font-semibold">Formula 1</span>
            <span class="block text-xs text-muted">2024 Season Explorer</span>
          </span>
        </a>
        <button id="menu-close" type="button" class="btn px-2 lg:hidden" aria-label="Close menu">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 py-2">
        <p class="label px-3 pb-2 pt-3">Season</p>
        <ul class="space-y-1">
          {nav.map((item) => (
            <li>
              <a href={url(item.href)} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                <svg class="h-[18px] w-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="label px-3 pb-2 pt-6">Project</p>
        <ul class="space-y-1">
          {secondaryNav.map((item) => (
            <li>
              <a href={url(item.href)} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                <svg class="h-[18px] w-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="border-t border-line p-3">
        <button id="theme-toggle" type="button" class="nav-link w-full" aria-label="Switch color theme">
          <svg class="h-[18px] w-[18px] shrink-0 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="hidden h-[18px] w-[18px] shrink-0 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <span class="dark:hidden">Dark mode</span>
          <span class="hidden dark:inline">Light mode</span>
        </button>
      </div>
    </aside>

    <!-- Page content -->
    <div class="lg:pl-64">
      <main id="main" class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
        {heading && (
          <div class="mb-6 lg:mb-8">
            <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{heading}</h1>
            {subtitle && <p class="mt-1 text-sm text-muted sm:text-base">{subtitle}</p>}
          </div>
        )}
        <slot />
      </main>
      <footer class="mx-auto max-w-6xl px-4 pb-8 text-xs text-faint sm:px-6 lg:px-8">
        Data from the Jolpica F1 API. Not affiliated with Formula 1 or the FIA.
      </footer>
    </div>

    <script>
      // Theme toggle (the initial theme is applied by the inline script in <head>)
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', dark);
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      });

      // Mobile menu
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('menu-backdrop');
      const openButton = document.getElementById('menu-open');
      const setMenu = (open: boolean) => {
        sidebar?.classList.toggle('-translate-x-full', !open);
        backdrop?.classList.toggle('hidden', !open);
        openButton?.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('overflow-hidden', open);
      };
      openButton?.addEventListener('click', () => setMenu(true));
      document.getElementById('menu-close')?.addEventListener('click', () => setMenu(false));
      backdrop?.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
    </script>
  </body>
</html>
